# Copy to terraform.tfvars (gitignored) and fill in. Never commit the copy.

# az account show --query id -o tsv
subscription_id = "00000000-0000-0000-0000-000000000000"

# Your public IPv4 address as a /32 (AKS accepts IPv4 only): curl -4 -s https://ifconfig.me
api_server_authorized_ip_ranges = ["203.0.113.7/32"]

